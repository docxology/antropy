# Preserve scientific artifact bytes while keeping source checkout endings stable.
* text=auto eol=lf
*.csv -text whitespace=blank-at-eol,blank-at-eof,space-before-tab,cr-at-eol
*.pdf binary
*.png binary
*.npy binary
*.npz binary
# Preserve raw command receipts, including logger padding, and Markdown hard breaks.
output/reports/verification/*.log -text whitespace=-blank-at-eol
output/reviews/*.md whitespace=-blank-at-eol
